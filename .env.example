# Copy to .env in the repo root; Docker Compose reads it automatically.
JEV_API_KEY=replace-with-your-server-key
# Optional stable host-page token. Leave empty to generate one at startup.
HOST_TOKEN=
# Local access by default. Use 0.0.0.0 only for deliberate remote hosting.
DOCKER_BIND_IP=127.0.0.1
DOCKER_PORT=3100
